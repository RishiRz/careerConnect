# ===========================================================
# CareerConnect Environment Variables — Template
# ===========================================================

# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/careerconnect?retryWrites=true&w=majority

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Sessions ----
SESSION_SECRET=replace-this-with-a-64-char-random-hex-string-for-session-encryption

# ---- CORS ----
CLIENT_ORIGIN=http://localhost:5173

# ---- AWS S3-compatible Storage ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=careerconnect-resumes
AWS_S3_ENDPOINT=

# ---- Email ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@careerconnect.dev

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10

# ---- Session TTL ----
SESSION_MAX_AGE_MS=86400000

# ===========================================================
# Frontend (Vite)
# ===========================================================
VITE_API_BASE=http://localhost:5000/api/v1
